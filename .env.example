# ==============================================================================
# 1TimeLink VPS Environment Configuration Template
# Copy this file to '.env' and fill in all variables before running install.sh
# ==============================================================================

# Database Settings (For local Postgres setup, leave host as localhost/127.0.0.1)
POSTGRES_DB=onetimelink
POSTGRES_USER=onetimelink_user
POSTGRES_PASSWORD=generate_your_secure_db_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/onetimelink
SPRING_DATASOURCE_USERNAME=onetimelink_user
SPRING_DATASOURCE_PASSWORD=generate_your_secure_db_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Security Keys
DB_ENCRYPTION_KEY=generate_32_char_hex_encryption_key_here

# App Base URL (Caddy will automatically request SSL for this domain)
APP_BASE_URL=https://yourdomain.com

# Cryptographic License Key (Generated by administrator)
LICENSE_KEY=your_license_key_here

# Slack App settings (Obtained from Slack API Console)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_PROXY_SECRET=generate_secure_slack_proxy_secret_here
SLACK_MONITOR_WEBHOOK=your_slack_error_monitoring_webhook_url

# Cloud Storage S3 Configuration (Required for secure file sharing)
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_ENDPOINT=your_s3_endpoint_url
S3_BUCKET_NAME=your_s3_bucket_name

# GitHub Container Registry credentials (Required to pull private container images)
GITHUB_USERNAME=your_github_username
GITHUB_PAT=your_github_classic_pat

# ==============================================================================
# OpenTelemetry Monitoring (Optional, uncomment and fill if needed)
# ==============================================================================
# OTEL_RESOURCE_ATTRIBUTES=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=
# OTEL_LOG_LEVEL=
# GRAFANA_CLOUD_OTLP_ENDPOINT=
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_KEY=
